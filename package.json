{
  "name": "shuttle-piping",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run build:worker",
    "build:web": "npm --prefix web run build",
    "build:worker": "tsc -p worker/tsconfig.json",
    "dev": "npm run build:web && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.99.0"
  }
}
